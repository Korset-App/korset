{
  "$schema": "https://opencode.ai/config.json",

  "small_model": "iyhapi/gemini-3-flash",

  "compaction": {
    "auto": true,
    "tail_turns": 12
  },

  "tool_output": {
    "max_lines": 150,
    "max_bytes": 12000
  },

  "agent": {
    "explore": {
      "model": "iyhapi/gemini-3-flash"
    },
    "general": {
      "model": "iyhapi/claude-sonnet-4.6"
    }
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    }
  },

  "permission": {
    "bash": {
      "*": "allow",
      "vercel *": "ask",
      "npx vercel *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "supabase db reset*": "ask"
    }
  }
}
