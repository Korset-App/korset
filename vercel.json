{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/store-seo.js": {
      "includeFiles": "dist/index.html"
    },
    "api/product-seo.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(index\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/integration", "destination": "/api/admin-stores?route=integration" },
    { "source": "/api/push/(.*)", "destination": "/api/push?route=$1" },
    { "source": "/api/ai-transcribe", "destination": "/api/ai" },
    { "source": "/api/ai-image", "destination": "/api/ai" },
    { "source": "/api/telegram-webhook", "destination": "/api/webhooks" },
    { "source": "/api/sentry-webhook", "destination": "/api/webhooks" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/s/:storeSlug/product/:ean", "destination": "/api/product-seo?storeSlug=$1&ean=$2" },
    { "source": "/s/:storeSlug", "destination": "/api/store-seo?storeSlug=$1" },
    { "source": "/stores/:storeSlug", "destination": "/api/store-seo?storeSlug=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
