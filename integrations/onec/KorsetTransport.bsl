// Common server module source. Invoke only from a scheduled/background job.
// The caller owns durable queue storage and passes unchanged JSON on every retry.

Функция ПроверитьНастройки(Хост, Путь, Токен) Экспорт
	Если Не ЗначениеЗаполнено(Хост) Или СтрНайти(Хост, "/") > 0
		Или СтрНайти(Хост, ":") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Путь <> "/api/integration" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Лев(Токен, 5) <> "krt1_" Или СтрДлина(Токен) <> 69 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 6 По 69 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Токен, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ОтправитьСохраненныйПакет(Хост, Путь, Токен, ТекстJSON, ИдентификаторЗапроса) Экспорт
	Если Не ПроверитьНастройки(Хост, Путь, Токен) Тогда
		Возврат Новый Структура("Действие,Причина", "stop", "invalid_configuration");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат Новый Структура("Действие,Причина", "stop", "missing_request_id");
	КонецЕсли;
	Если ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8).Размер() > 1048576 Тогда
		Возврат Новый Структура("Действие,Причина", "stop", "payload_too_large");
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Попытка
		Соединение = Новый HTTPСоединение(Хост, 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Возврат Новый Структура("Действие,Причина", "retry", "transport_failure");
	КонецПопытки;

	Если Ответ.КодСостояния = 429 Тогда
		Возврат Новый Структура("Действие,Причина,ПовторЧерез", "retry", "rate_limited", Ответ.Заголовки.Получить("Retry-After"));
	КонецЕсли;
	Если Ответ.КодСостояния >= 500 Тогда
		Возврат Новый Структура("Действие,Причина", "retry", "server_failure");
	КонецЕсли;
	Если Ответ.КодСостояния = 401 Или Ответ.КодСостояния = 403 Тогда
		Возврат Новый Структура("Действие,Причина", "pause", "access_denied");
	КонецЕсли;
	Если Ответ.КодСостояния = 400 Тогда
		Возврат Новый Структура("Действие,Причина", "stop", "invalid_payload");
	КонецЕсли;
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		Возврат Новый Структура("Действие,Причина", "pause", "unexpected_status");
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
		Подтверждение = ПрочитатьJSON(Чтение, Ложь);
		Если ТипЗнч(Подтверждение) <> Тип("Структура") Тогда
			Возврат Новый Структура("Действие,Причина", "retry", "invalid_ack");
		КонецЕсли;
		НомерОтвета = Неопределено;
		Результат = Неопределено;
		Если Не Подтверждение.Свойство("request_id", НомерОтвета)
			Или Не Подтверждение.Свойство("result", Результат)
			Или НРег(Строка(НомерОтвета)) <> НРег(Строка(ИдентификаторЗапроса))
			Или ТипЗнч(Результат) <> Тип("Структура") Тогда
			Возврат Новый Структура("Действие,Причина", "retry", "invalid_ack");
		КонецЕсли;
		Для Каждого ИмяПоля Из СтрРазделить("applied,unresolved,conflicts,stale", ",") Цикл
			Количество = Неопределено;
			Если Не Результат.Свойство(ИмяПоля, Количество)
				Или ТипЗнч(Количество) <> Тип("Число")
				Или Количество < 0
				Или Количество <> Цел(Количество) Тогда
				Возврат Новый Структура("Действие,Причина", "retry", "invalid_ack");
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Новый Структура("Действие,Причина", "retry", "invalid_ack");
	КонецПопытки;

	Возврат Новый Структура("Действие,Причина,Результат", "ack", "durable_receipt", Результат);
КонецФункции
